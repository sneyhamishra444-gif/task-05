# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Used by Prisma. Must point at a PostgreSQL instance (no SQLite/Mongo/etc allowed).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# --- Redis (BullMQ + rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Use long, random, distinct secrets in real deployments (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Security ---
BCRYPT_COST_FACTOR=12
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
