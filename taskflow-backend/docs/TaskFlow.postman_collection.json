{
  "info": {
    "name": "TaskFlow API",
    "description": "TaskFlow backend (Tasks 01-04). Run requests top-to-bottom within a folder (or use Collection Runner) - each request's Tests script captures what the next request needs (tokens, ids) into collection variables, so this works right after import with zero manual edits. Just make sure the API is running at {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "registeredEmail",
      "value": ""
    },
    {
      "key": "registeredPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "orgId",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": ""
    },
    {
      "key": "memberUserId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register (creates user + org, captures tokens)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('registeredEmail')) {",
                  "  pm.collectionVariables.set('registeredEmail', `postman-${Date.now()}@example.com`);",
                  "  pm.collectionVariables.set('registeredPassword', 'PostmanPass123');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "pm.collectionVariables.set('orgId', body.organization.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\",\n  \"name\": \"Postman Tester\",\n  \"organizationName\": \"Postman Org {{$timestamp}}\"\n}"
            }
          }
        },
        {
          "name": "Login (re-authenticates as the same registered user, same org)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registeredPassword}}\"\n}"
            },
            "description": "Logs back into the account created by 'Register' above, so {{orgId}} stays consistent with {{accessToken}} for every request below. To log in as a different (e.g. seeded) user instead, just edit the email/password in this request body."
          }
        },
        {
          "name": "Get current user (/auth/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Refresh token (rotates it)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', body.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout (revokes current refresh token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout all devices (bonus)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout-all"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Organization Members",
      "item": [
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "members"
              ]
            }
          }
        },
        {
          "name": "Register a second user (to add as member)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('memberEmail', body.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-member-{{$timestamp}}@example.com\",\n  \"password\": \"PostmanPass123\",\n  \"name\": \"Postman Member\",\n  \"organizationName\": \"Throwaway {{$timestamp}}\"\n}"
            }
          }
        },
        {
          "name": "Add member to org (org_admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('memberUserId', pm.response.json().userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "members"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"role\": \"member\"\n}"
            }
          }
        },
        {
          "name": "Change a member's role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/members/{{memberUserId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "members",
                "{{memberUserId}}",
                "role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"org_admin\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "03 - Projects",
      "item": [
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('projectId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Project\",\n  \"description\": \"Created from the Postman collection\"\n}"
            }
          }
        },
        {
          "name": "List projects (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects",
                "{{projectId}}"
              ]
            }
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects",
                "{{projectId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated via Postman\"\n}"
            }
          }
        },
        {
          "name": "Project dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects/{{projectId}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects",
                "{{projectId}}",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Tasks",
      "item": [
        {
          "name": "Create task in project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('taskId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Demo Task\",\n  \"description\": \"Created from the Postman collection\",\n  \"priority\": \"high\",\n  \"status\": \"todo\"\n}"
            }
          }
        },
        {
          "name": "List tasks in project (filters + pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects/{{projectId}}/tasks?status=todo&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "todo"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "disabled": true
                },
                {
                  "key": "assignee",
                  "value": "{{memberUserId}}",
                  "disabled": true
                },
                {
                  "key": "dueDateFrom",
                  "value": "2026-01-01T00:00:00.000Z",
                  "disabled": true
                },
                {
                  "key": "dueDateTo",
                  "value": "2026-12-31T00:00:00.000Z",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get task",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "{{taskId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            }
          }
        },
        {
          "name": "Assign member to task (enqueues email job)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('jobId', pm.response.json().notificationJobId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/{{taskId}}/assignments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "{{taskId}}",
                "assignments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{memberUserId}}\"\n}"
            },
            "description": "Run '02 - Organization Members > Add member to org' first so {{memberUserId}} is populated."
          }
        },
        {
          "name": "List assignments for task",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/{{taskId}}/assignments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "{{taskId}}",
                "assignments"
              ]
            }
          }
        },
        {
          "name": "Unassign member from task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/{{taskId}}/assignments/{{memberUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "{{taskId}}",
                "assignments",
                "{{memberUserId}}"
              ]
            }
          }
        },
        {
          "name": "Bulk update task status (bonus)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/bulk-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "bulk-status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskIds\": [\"{{taskId}}\"],\n  \"status\": \"done\"\n}"
            }
          }
        },
        {
          "name": "Full-text search tasks (bonus)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/search?q=demo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "demo"
                }
              ]
            }
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Jobs",
      "item": [
        {
          "name": "Get job status (from assignment's notificationJobId)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Run '04 - Tasks > Assign member to task' first so {{jobId}} is populated. Run the worker process (`npm run worker:dev`) to see status move from pending -> active -> completed."
          }
        }
      ]
    },
    {
      "name": "06 - Cleanup",
      "item": [
        {
          "name": "Remove a member",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/members/{{memberUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "members",
                "{{memberUserId}}"
              ]
            }
          }
        },
        {
          "name": "Delete project (org_admin only)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/orgs/{{orgId}}/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orgs",
                "{{orgId}}",
                "projects",
                "{{projectId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}